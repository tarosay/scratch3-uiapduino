{
  "name": "xcx-uiapduino",
  "version": "0.2.5",
  "description": "UIAPduino extension for Xcratch",
  "extensionId": "uiapduino",
  "license": "BSD-3-Clause",
  "scripts": {
    "setup-dev": "node ./scripts/setup-dev.mjs",
    "sync-block": "node ./scripts/sync-block.mjs",
    "embed-bin": "node ./scripts/embed-bin.mjs",
    "prebuild": "npm run sync-block",
    "build": "rollup -c ./scripts/rollup.config.mjs",
    "postbuild": "node ./scripts/publish-docs.mjs",
    "prewatch": "npm run sync-block",
    "watch": "rollup -c ./scripts/rollup.config.mjs --watch"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/runtime": "^7.28.2",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-multi-entry": "^6.0.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "fs-extra": "^11.3.0",
    "format-message": "^6.2.4",
    "rollup": "^4.46.1",
    "rollup-plugin-polyfill-node": "^0.13.0"
  }
}
