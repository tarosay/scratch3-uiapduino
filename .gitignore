.vscode/
.DS_Store

# Claude Code の端末ごとの設定（許可したコマンドの一覧）。
# 絶対パスとセッション ID が入るので、リポジトリには持たせない。
.claude/

# 作業用ファイルの置き場。どの階層にあっても追跡しない。
#
# 80x80 のアイコンを作る元にした高解像度の画像 (uiapduino-819.png や
# keyboard448.png など) は、そのまま置くと 1 枚で数百 KB あるうえに
# 完成品と紛らわしい。scratch-gui/.../uiapduino/ignore/ に寄せてある。
ignore/

!.gitignore
!README.md

# スケッチをビルドすると .bin と一緒に出てくるもの。
# 追跡するのは sketches/ScratchUiapduino.ino.bin だけでよい
# (拡張機能へ埋め込む元。embed-bin.mjs が読む)。
/sketches/*.elf
/sketches/*.hex
/sketches/*.map

# 上流リポジトリに被せるファイルだけを追跡する（ホワイトリスト方式）。
# ビルド時に clone される scratch-vm / scratch-gui / scratch-desktop の
# 本体は追跡しない。

/scratch-vm/*
!/scratch-vm/LICENSE
!/scratch-vm/src
/scratch-vm/src/*
!/scratch-vm/src/extensions
/scratch-vm/src/extensions/*
!/scratch-vm/src/extensions/scratch3_uiapduino
!/scratch-vm/src/extension-support
/scratch-vm/src/extension-support/*
!/scratch-vm/src/extension-support/extension-manager.js

/scratch-gui/*
!/scratch-gui/LICENSE
!/scratch-gui/src
/scratch-gui/src/*
!/scratch-gui/src/lib
/scratch-gui/src/lib/*
!/scratch-gui/src/lib/libraries
/scratch-gui/src/lib/libraries/*
!/scratch-gui/src/lib/libraries/extensions
/scratch-gui/src/lib/libraries/extensions/*
!/scratch-gui/src/lib/libraries/extensions/index.jsx
!/scratch-gui/src/lib/libraries/extensions/uiapduino

# 拡張機能一覧と接続モーダルの訳文を scratch-l10n のメッセージへ重ねる
!/scratch-gui/src/reducers
/scratch-gui/src/reducers/*
!/scratch-gui/src/reducers/locales.js

# 接続モーダルのバッジを拡張機能ごとに差し替えられるようにする
!/scratch-gui/src/containers
/scratch-gui/src/containers/*
!/scratch-gui/src/containers/connection-modal.jsx
!/scratch-gui/src/components
/scratch-gui/src/components/*
!/scratch-gui/src/components/connection-modal
/scratch-gui/src/components/connection-modal/*
!/scratch-gui/src/components/connection-modal/connected-step.jsx
!/scratch-gui/src/components/connection-modal/connecting-step.jsx

# WebHID の許可設定のため main プロセスにもパッチを当てる
/scratch-desktop/*
!/scratch-desktop/src
/scratch-desktop/src/*
!/scratch-desktop/src/main
/scratch-desktop/src/main/*
!/scratch-desktop/src/main/index.js

# --- Xcratch 版 --------------------------------------------------------
# src/vm の下は setup-dev.mjs が張るリンクと sync-block.mjs が置く複製で、
# 実体は scratch-vm 側にある。追跡すると中身が二重に入る。
#
# dist/ も追跡しない。配るのは docs/ に置いたものだけで、
# dist/ はその手前の中間成果物。両方持つと同じ .mjs が git に二重に入る。
/xcratch/node_modules/
/xcratch/dist/
/xcratch/src/vm/extension-support
/xcratch/src/vm/util
/xcratch/src/vm/extensions/block
